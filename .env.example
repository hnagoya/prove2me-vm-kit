# このファイルを .env にコピーして、実際の値を埋めてから使う。
# .env は .gitignore 済みなのでコミットされない。
#
#   cp .env.example .env
#   vim .env
#   source .env

# Linode Cloud Manager で作成したStackScriptのID
export STACKSCRIPT_ID=

# 自己破壊タイマー用の Linode APIトークン(Linodes Read/Write権限)
# 空欄にすると自己破壊しない(stop.shの叩き忘れに注意)
export DESTROY_TOKEN=

# 何時間後にVMを自動削除するか
export DESTROY_HOURS=6
