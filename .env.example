# このファイルを .env にコピーして、実際の値を埋めてから使う。
# .env は .gitignore 済みなのでコミットされない。
# start.sh / stop.sh はスクリプトと同じディレクトリの .env を自動で読み込むので、
# 手動で source .env する必要はない。
#
#   cp .env.example .env
#   vim .env

# Linode Cloud Manager で作成したStackScriptのID
export STACKSCRIPT_ID=

# 自己破壊タイマー用の Linode APIトークン(Linodes Read/Write権限)
# 空欄にすると自己破壊しない(stop.shの叩き忘れに注意)
export DESTROY_TOKEN=

# 何時間後にVMを自動削除するか
export DESTROY_HOURS=6

# --- VM のスペック(未設定なら start.sh 内のデフォルト値が使われる)---

# Linode のラベル(表示名)
export LABEL=prove2me-work

# リージョン(linode-cli regions list で一覧表示)
export REGION=jp-tyo-3

# インスタンスタイプ(重ければ g6-dedicated-8 など)
export TYPE=g6-dedicated-4

# ベースイメージ
export IMAGE=linode/ubuntu26.04
